{
  "manifestVersion": 6,
  "id": "net.synkit.reflex",
  "name": "Reflex",
  "version": "0.6.7",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "26.0.0", "data": { "apiVersion": 2 } },
  "addon": { "name": "reflex.uxpaddon" },
  "requiredPermissions": { "enableAddon": true },
  "icons": [
    { "width": 24, "height": 24, "path": "assets/plugin-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"], "species": ["generic", "pluginList"] },
    { "width": 24, "height": 24, "path": "assets/plugin-light.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["generic", "pluginList"] }
  ],
  "entrypoints": [
    {
      "type": "panel", "id": "reflex", "label": { "default": "Reflex" },
      "icons": [
        { "width": 23, "height": 23, "path": "assets/panel-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "assets/panel-light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ],
      "minimumSize": { "width": 320, "height": 360 },
      "maximumSize": { "width": 2400, "height": 1800 },
      "preferredDockedSize": { "width": 400, "height": 620 },
      "preferredFloatingSize": { "width": 440, "height": 620 }
    },
    {
      "type": "command", "id": "search", "label": { "default": "Search" }
    },
    {
      "type": "command", "id": "wheel", "label": { "default": "Quick wheel" }
    }
  ]
}
